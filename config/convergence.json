    "app/HomeLandingClientV2.tsx",
    "app/HomeLandingClientV3.tsx",
    "app/HomeLandingClientV4.tsx",
    "src/components/landing/HomeLandingClientV2.tsx",
    "src/components/landing/HomeLandingClientV3.tsx",
